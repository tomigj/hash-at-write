# witnessd hash-at-write agent — installs on the PRIMARY host.
#
# RuntimeDirectory=integrity is the correct answer to a problem deferred at
# step 2. The socket belongs under /run, but /run is root-owned so the agent
# cannot create its own directory there, and adding a manual mkdir would leave
# a directory nothing cleans up. systemd creates /run/integrity at start with
# the ownership and mode below, and removes it at stop.
#
# Restart=always, and it must be `always` rather than `on-failure`. This shipped
# as on-failure and was wrong in a way that inverted the property it was meant
# to provide.
#
# The agent catches SIGTERM and exits 0, so that shutdown is clean and no stale
# socket is left behind. systemd's on-failure restarts on a non-zero exit or on
# death by signal, but explicitly EXCLUDES SIGTERM, and never restarts a clean
# exit at all. Measured on this code:
#
#     kill <pid>      SIGTERM -> exit 0   -> NOT restarted, stays down
#     kill -9 <pid>   SIGKILL -> exit 137 -> restarted after RestartSec
#
# The cheap quiet attack worked; the loud one was defeated. Exactly backwards.
#
# With Restart=always any exit brings the agent back, while `systemctl stop` and
# masking still work, because systemd distinguishes an administrative stop from
# a process exit. That is the intended property: killing the agent is
# ineffective, and keeping it down requires an action that leaves a journal
# record.
#
# Making the SIGTERM handler exit non-zero would also have worked, and is worse:
# every ordinary `systemctl stop` would then look like a failure in the journal,
# putting a false failure signal into the records of a system whose entire
# purpose is trustworthy records.
#
# This narrows the fabrication window. It does not close it — nothing can, while
# an attacker with root can write the records the agent would have written.
#
# NOTE: the repository path differs between the two hosts. On the primary it is
# ~/witnessd; on the ledger it is ~/NIW. Adjust WorkingDirectory and ExecStart
# to match the host this is installed on.

[Unit]
Description=witnessd hash-at-write logging agent
Documentation=https://github.com/tomigj/witnessd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tomigj
Group=integrity
WorkingDirectory=/home/tomigj/witnessd

RuntimeDirectory=integrity
RuntimeDirectoryMode=0750

ExecStart=/usr/bin/python3 /home/tomigj/witnessd/agent/agent.py \
    --socket /run/integrity/agent.sock \
    --log /var/log/integrity/events.log \
    --state /var/lib/integrity/agent.state \
    --spool /var/lib/integrity/pending.jsonl \
    --timing-log /var/log/integrity/timing.log \
    --ledger-host 10.0.0.212 \
    --ledger-port 9900 \
    --heartbeat-interval 60

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

# The agent needs to write only its own directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/log/integrity /var/lib/integrity

[Install]
WantedBy=multi-user.target
